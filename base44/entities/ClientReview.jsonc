{
  "name": "ClientReview",
  "type": "object",
  "properties": {
    "review_code": {
      "type": "string",
      "description": "CODE_AVIS (Unique identifier for the review)"
    },
    "client_id": {
      "type": "string",
      "description": "CODE_CLIENT (User ID of the client being reviewed)"
    },
    "provider_id": {
      "type": "string",
      "description": "CODE_PRESTATAIRE (User ID of the provider leaving the review)"
    },
    "comment": {
      "type": "string",
      "description": "COMMENTAIRE (Details about the experience with the client)"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "NOTE_CLIENT (Rating from 1 to 5)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Moderation status of the review"
    },
    "moderation_note": {
      "type": "string",
      "description": "Admin note for rejection or approval"
    }
  },
  "required": [
    "client_id",
    "provider_id",
    "rating",
    "comment"
  ]
}