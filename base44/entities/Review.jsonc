{
  "name": "Review",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Moderation status of the review"
    },
    "moderation_note": {
      "type": "string",
      "description": "Admin note for rejection or approval"
    }
  },
  "required": [
    "service_id",
    "rating"
  ]
}